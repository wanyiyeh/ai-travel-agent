# 複製成 .env 後填入自己的值（.env 不會進 git）。Prisma 指令只讀 .env，所以
# 資料庫設定要放在 .env；Next.js 會同時讀 .env 與 .env.local。
# 每個變數的說明見 README.md「環境變數」。正式環境的值設在 Vercel，不寫進任何檔案。

# ── 資料庫（本機 Docker：npm run db:up）────────────────────────────────────────
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel"

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Google（兩把 key 分開：後端只開 Places API (New)、Routes API；
#    前端只開 Maps JavaScript API、Places UI Kit，並限制網域）────────────────
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── 登入（Auth.js）─────────────────────────────────────────────────────────
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 管理者 email，逗號分隔；不受使用額度限制
# ADMIN_EMAILS=

# ── 正式環境必填（本機可留空）──────────────────────────────────────────────
# Cloudflare Turnstile。本機沒設定會略過驗證；正式環境沒設定會拒絕生成。
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Vercel Cron 呼叫 /api/cron/daily 用的密碼，16 個字元以上
# CRON_SECRET=
# 1 = CSP 從 Report-Only 改成強制執行（#250）
# CSP_ENFORCE=

# ── 開發用的 mock（不要在正式環境設定）──────────────────────────────────────
# 一般直接用 npm run dev:free（Google 與 OpenAI 都是假的）或 dev:mock（只有 Google 是假的）。
# MOCK_AI=1        立即回傳假資料，不呼叫 OpenAI；slow = 延遲 3.5 秒；error = 一律失敗
# MOCK_PLACES=1    Google 全部回假資料，DATABASE_URL 必須是含 mock 的資料庫
# MOCK_DATABASE_URL=postgresql://travel:travel@localhost:5432/travel_mock
# CLIMATE_LOOKUPS=off   不查 Open-Meteo 氣候資料
