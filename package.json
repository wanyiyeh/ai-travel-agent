    "validate-preference-intent": "tsx scripts/validate-preference-intent.ts",
    "batch-test-rule-engine": "tsx scripts/batch-test-rule-engine.ts",
    "eval-form-fidelity": "tsx scripts/eval-form-fidelity.ts",
    "claim-demo-itineraries": "tsx scripts/claim-demo-itineraries.ts",
    "cleanup-expired-guests": "tsx scripts/cleanup-expired-guests.ts",
    "purge-expired-coords": "tsx scripts/purge-expired-coords.ts",
    "audit-google-content": "tsx scripts/audit-google-content.ts",
    "cleanup-google-content": "tsx scripts/cleanup-google-content.ts",
    "copy-sqlite-to-postgres": "tsx scripts/copy-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
