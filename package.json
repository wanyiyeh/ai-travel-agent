{
  "name": "ai-travel-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:free": "node scripts/dev-mock.mjs --mock-ai",
    "db:up": "docker compose up -d --wait db",
    "build": "prisma generate && next build",
    "start": "next start",
