generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id          String      @id @default(uuid())
  email       String      @unique
  name        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  itineraries Itinerary[]
}


model Itinerary {
  id                          String                       @id @default(uuid())
  userId                      String                       @map("user_id")
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                       String
  days                        String
  config                      String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  accommodationCandidateLogs  AccommodationCandidateLog[]
  mealCandidateLogs           MealCandidateLog[]
  stopCandidateLogs           StopCandidateLog[]
  deletedStops                DeletedStop[]
  deletedDays                 DeletedDay[]
  recommendationCaches        ItineraryRecommendationCache[]
}


model Place {
  id        String        @id
  name      String
  address   String?
  lat       Float?
  lng       Float?
  rating    Float?
  types     String?       // JSON-encoded string[] from Google Places (e.g. ["restaurant","food"])
  photoName String?       // Places API photo resource name (e.g. "places/{id}/photos/{ref}"), not a URL — see /api/v1/places/[placeId]/photo
  updatedAt DateTime      @updatedAt
  queries   PlaceQuery[]
}

model PlaceQuery {
  query    String   @id
  placeId  String
  place    Place    @relation(fields: [placeId], references: [id])
  cachedAt DateTime @default(now())
}

// Full history of every accommodation candidate batch shown to the user for a
// given day (one row per POST /accommodation/regenerate call) — lets the user
// review what options existed even after picking a different one.
model AccommodationCandidateLog {
  id          String    @id @default(uuid())
  itineraryId String    @map("itinerary_id")
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayId       String    @map("day_id")
  candidates  String    // JSON-encoded AccommodationCandidate[]
  createdAt   DateTime  @default(now())

  @@index([itineraryId, dayId])
}

// Same idea as AccommodationCandidateLog, but scoped per meal slot — one row
// per POST /meals/[mealType]/regenerate call (mealType: "breakfast" | "lunch" | "dinner" | "snack").
model MealCandidateLog {
  id          String    @id @default(uuid())
  itineraryId String    @map("itinerary_id")
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayId       String    @map("day_id")
  mealType    String    @map("meal_type")
  candidates  String    // JSON-encoded MealCandidate[]
  createdAt   DateTime  @default(now())

  @@index([itineraryId, dayId, mealType])
}

// Same idea as AccommodationCandidateLog, but scoped per stop — one row per
// POST /stop-suggestions call for that specific stop (a day can have several
// stops, each replaced independently, so history is keyed by stopId too).
model StopCandidateLog {
  id          String    @id @default(uuid())
  itineraryId String    @map("itinerary_id")
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayId       String    @map("day_id")
  stopId      String    @map("stop_id")
  candidates  String    // JSON-encoded StopCandidate[]
  createdAt   DateTime  @default(now())

  @@index([itineraryId, dayId, stopId])
}

// A stop removed from an itinerary, kept around so it can be browsed and
// restored from a "trash bin" view instead of being lost immediately.
model DeletedStop {
  id            String    @id @default(uuid())
  itineraryId   String    @map("itinerary_id")
  itinerary     Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayId         String    @map("day_id")
  dayNumber     Int       @map("day_number")
  originalIndex Int       @map("original_index")
  stop          String    // JSON-encoded Stop
  deletedAt     DateTime  @default(now())

  @@index([itineraryId])
}

// Same idea as DeletedStop, but for a whole day removed by the restructure
// flow (e.g. shrinking a city's day count) — snapshots the full Day object
// so it can be restored intact, including its own stops/accommodation/meals.
model DeletedDay {
  id            String    @id @default(uuid())
  itineraryId   String    @map("itinerary_id")
  itinerary     Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  originalIndex Int       @map("original_index")
  day           String    // JSON-encoded Day (full object, incl. its stops)
  deletedAt     DateTime  @default(now())

  @@index([itineraryId])
}

// Corridor-specific stopovers between two distinct airports (the "順路推薦" case).
model TransitRecommendationCache {
  originIata      String
  destinationIata String
  recommendations String   // JSON-encoded TransitRecommendation[]
  updatedAt       DateTime @updatedAt

  @@id([originIata, destinationIata])
}

// Nearby-destination pool for a single airport (e.g. Kyoto/Nara/Kobe for KIX),
// shared by single-city trips and by each leg of a multi-city corridor.
model AirportRecommendationCache {
  iata            String   @id
  recommendations String   // JSON-encoded TransitRecommendation[]
  updatedAt       DateTime @updatedAt
}

// The specific recommendation list a given itinerary was shown for a given
// origin/destination pair. Once written, it stays fixed for that itinerary —
// unrelated to how the shared AirportRecommendationCache/TransitRecommendationCache
// above change over time — so reopening the same itinerary always shows the same
// options, and one itinerary's refresh never affects another's.
model ItineraryRecommendationCache {
  itineraryId     String
  itinerary       Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  originIata      String
  destinationIata String
  recommendations String    // JSON-encoded TransitRecommendation[]
  updatedAt       DateTime  @updatedAt

  @@id([itineraryId, originIata, destinationIata])
}

// Nearby Search results for a city's breakfast/main-meal/snack/attraction hint
// lists (see fetchCityRestaurants.ts), keyed by IATA code + hint kind (+ budget
// for the budget-sensitive main-meal kind). These lists barely change day to
// day, but were previously re-fetched from Google on every itinerary
// generation for the same city — this cache lets repeat generations for a
// popular city (e.g. Tokyo) reuse one Places API response instead of paying
// for it again.
model CityPlaceHintsCache {
  iataCode String
  kind     String   // "breakfast" | "mainMeal" | "snack" | "attraction"
  budget   String   @default("") // BudgetLevel for "mainMeal", "" otherwise
  hints    String   // JSON-encoded RestaurantHint[]
  updatedAt DateTime @updatedAt

  @@id([iataCode, kind, budget])
}

// Raw Nearby Search "candidate" pool (real placeId/lat/lng, not just name/rating)
// for a given point + search params — used by day stop-suggestions ("換一批")
// and accommodation candidate search. cacheKey encodes rounded coords, radius,
// maxCount, sorted types and sorted priceLevels so distinct call shapes never
// collide. Never written on an empty result, so a transient API failure or a
// genuinely sparse area just retries next time instead of caching "nothing" for
// 30 days.
model NearbyPlaceCandidatesCache {
  cacheKey   String   @id
  candidates String   // JSON-encoded PlaceCandidate[]
  updatedAt  DateTime @updatedAt
}

// Nearest subway/train/light-rail station for a rounded coordinate (see
// findNearestStation). station is null when a successful search genuinely
// found nothing within range — that "no station nearby" answer is itself
// stable and worth caching, unlike a network/HTTP failure (which is never
// written here at all, so it retries next time rather than getting pinned).
model NearestStationCache {
  cacheKey  String   @id
  station   String?  // JSON-encoded NearestStation, or null = confirmed none found
  updatedAt DateTime @updatedAt
}
